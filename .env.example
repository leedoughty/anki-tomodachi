ANTHROPIC_API_KEY='your-api-key'

# Default model as "provider/name". Leave unset for Anthropic Claude.
# Examples:
#   TOMODACHI_MODEL=ollama/qwen2.5:7b
#   TOMODACHI_MODEL=openai/gpt-4o
#   TOMODACHI_MODEL=anthropic/claude-sonnet-4-6
# TOMODACHI_MODEL=

# Only needed for the "openai" provider (or OpenAI-compatible endpoints).
# OPENAI_API_KEY=

# Card generation (作って) always runs on Claude via the Claude Agent SDK,
# whatever TOMODACHI_MODEL is set to, and always needs ANTHROPIC_API_KEY.
# The SDK requires API-key auth — a claude.ai subscription login won't work.
# TOMODACHI_CARD_MODEL=claude-sonnet-5

# Deck that 作って writes new cards into. Defaults to "Japanese Vocabulary".
# Point this at a scratch deck if you want to try card generation safely.
# TOMODACHI_DECK=
